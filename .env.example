# Chain-Trace Configuration
# Copy this file to .env and modify as needed

# Bitcoin RPC Configuration (Optional)
# If Bitcoin Core RPC is available, set credentials here
BTC_RPC_HOST=localhost
BTC_RPC_PORT=8332
BTC_RPC_USER=
BTC_RPC_PASSWORD=
BTC_BLOCKCHAIN_PATH=/path/to/.bitcoin/blocks

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend Configuration
FRONTEND_PORT=3000

# Analysis Options
MAX_ADDRESSES_PER_DERIVATION=100
MAX_TRANSACTIONS_PER_CHAIN=1000
ENABLE_TELEMETRY=false